partial module humanize {
	check "formatting" {
		use (
			std.testing
			std.time
		)

		@test()
		def byteCounts() {
			assert bytes(0) == "0 B"
			assert bytes(512) == "512 B"
			assert bytes(1000) == "1 kB"
			assert bytes(1536000) == "1.5 MB"
			assert bytes(3400000000) == "3.4 GB"
			assert bytes(-2048) == "-2 kB"
			assert bytes(1024, true) == "1 KiB"
			assert bytes(1536, true) == "1.5 KiB"
			assert bytes(3650722201, true) == "3.4 GiB"
		}

		@test()
		def durations() {
			assert span(0s) == "0s"
			assert span(350ms) == "350ms"
			assert span(45s) == "45s"
			assert span(2h + 5m) == "2h 5m"
			assert span(2h + 5m + 9s) == "2h 5m"
			assert span(76h) == "3d 4h"
			assert span(-90s) == "-1m 30s"
			assert span(12us) == "12µs"
		}

		@test()
		def relativeTimes() !none {
			let now = try time.parse("2026-09-03T12:00:00Z")
			assert ago(now, now) == "just now"
			assert ago(now - 3m, now) == "3 minutes ago"
			assert ago(now - 1h, now) == "an hour ago"
			assert ago(now - 26h, now) == "a day ago"
			assert ago(now - 72h, now) == "3 days ago"
			assert ago(now - 1440h, now) == "2 months ago"
			assert ago(now - 19200h, now) == "2 years ago"
			assert ago(now + 2h, now) == "in 2 hours"
		}

		@test()
		def ordinals() {
			assert ordinal(1) == "1st"
			assert ordinal(2) == "2nd"
			assert ordinal(3) == "3rd"
			assert ordinal(4) == "4th"
			assert ordinal(11) == "11th"
			assert ordinal(12) == "12th"
			assert ordinal(13) == "13th"
			assert ordinal(21) == "21st"
			assert ordinal(112) == "112th"
			assert ordinal(-3) == "-3rd"
		}

		@test()
		def thousands() {
			assert comma(0) == "0"
			assert comma(999) == "999"
			assert comma(1000) == "1,000"
			assert comma(1234567) == "1,234,567"
			assert comma(-1000) == "-1,000"
			assert comma(1234567, " ") == "1 234 567"
		}
	}
}
